# Variables de entorno para el servidor del agente.
# Copia este fichero a `.env` y rellena los valores antes de `npm start` en local.
# En producción (Fly.io, Render, Railway) NO uses este fichero: configura los
# secrets/secrets del proveedor con los mismos nombres.

# Token compartido con la app Android (header X-Agent-Token).
# Genéralo con: openssl rand -base64 32 | tr -d '/=+'
AGENT_TOKEN=

# Clave para z-ai-web-dev-sdk (la pide el SDK al instanciarse).
ZAI_API_KEY=

# Puerto HTTP (default 8080).
PORT=8080

# (Opcional) Override del system prompt del agente.
# AGENT_SYSTEM_PROMPT=
